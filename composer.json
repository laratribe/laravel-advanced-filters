{
    "name": "laratribe/laravel-advanced-filters",
    "description": "Advanced column filters for Laravel. Text, numeric, date and set filters with custom operators and strict allow-listing — declared once on an Eloquent model, then rendered with Blade + Alpine, Livewire, Inertia or as a JSON API.",
    "keywords": ["laravel", "filters", "eloquent", "blade", "alpine", "livewire", "inertia", "query-builder", "datatable"],
    "license": "MIT",
    "homepage": "https://github.com/laratribe/laravel-advanced-filters",
    "support": {
        "issues": "https://github.com/laratribe/laravel-advanced-filters/issues",
        "source": "https://github.com/laratribe/laravel-advanced-filters",
        "docs": "https://laratribe.github.io/laravel-advanced-filters",
        "demo": "https://advanced-filters.laratribe.com"
    },
    "authors": [
        {
            "name": "Ram Sharma",
            "email": "rns6393@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.18",
        "livewire/livewire": "^3.0|^4.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0"
    },
    "suggest": {
        "livewire/livewire": "Required only if you use the Livewire <livewire:advanced-filters::panel /> adapter."
    },
    "autoload": {
        "psr-4": {
            "Laratribe\\AdvancedFilters\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laratribe\\AdvancedFilters\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\": "workbench/database/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse",
        "workbench:serve": [
            "@php vendor/bin/testbench serve"
        ],
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "policy": {
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laratribe\\AdvancedFilters\\AdvancedFiltersServiceProvider"
            ],
            "aliases": {
                "AdvancedFilters": "Laratribe\\AdvancedFilters\\Facades\\AdvancedFilters"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
